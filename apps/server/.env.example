# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=andos_dev
DB_NAME_TEST=andos_test
DB_USER=andos
DB_PASSWORD=andos
DB_SSL=false

# Environment
NODE_ENV=development

# JWT (for future use)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Server
PORT=3000
HOST=0.0.0.0

# LLM Configuration
# Default provider: anthropic, openai, or openai-compatible
LLM_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-3-opus-20240229
LLM_TIMEOUT=60000

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_DEFAULT_MODEL=claude-3-opus-20240229

# OpenAI
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_DEFAULT_MODEL=gpt-4
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI-Compatible (e.g., local LLMs, Azure, etc.)
# OPENAI_COMPATIBLE_API_KEY=your-api-key
# OPENAI_COMPATIBLE_DEFAULT_MODEL=gpt-4
# OPENAI_COMPATIBLE_BASE_URL=https://your-compatible-endpoint.com/v1
